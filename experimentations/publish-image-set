# Look at Test Observer for currently approved builds, and generate
# publish-release commands for them.

from collections import defaultdict
import argparse
import re
import sys

import requests

milestone_name_re = re.compile(r'(Beta|Final|Snapshot)(?: (\d))?', re.I)

type_map = {
    'desktop':              'daily-live',
    'dvd':                  'dvd',
    'server':               'daily',
    'base':                 'daily',
    'wsl':                  'daily-live',
    'preinstalled-desktop': 'daily-preinstalled',
    'preinstalled-server':  'ubuntu-server/daily-preinstalled',
    'live-server':          'ubuntu-server/daily-live',
    'mini-iso':             'daily-live',
    'minimal':              'daily-minimal',
}

PRIMARY_ARCHES = {'amd64', 'i386'}
OFFICIAL_TYPES = {'desktop', 'live-server', 'wsl'}


def get_artifacts(series, base_url):
    params = {"family": "image"}
    response = requests.get(base_url + "/v1/artefacts", params=params)
    response.raise_for_status()
    artifacts = [a for a in response.json()
                 if a["release"] == series and a["status"] == "APPROVED"]
    sys.stderr.write("Found %d approved artifacts\n" % len(artifacts))
    return artifacts


def get_arch(artifact, base_url):
    response = requests.get(base_url + "/v1/artefacts/%d/builds" % artifact["id"])
    response.raise_for_status()
    builds = response.json()
    if not builds:
        return None
    return builds[0]["architecture"].split(".")[0]


def derive_image_metadata(artifact):
    os = artifact["os"]
    name = artifact["name"]

    if "preinstalled" in name:
        img_type = "preinstalled-server" if os == "ubuntu-server" else "preinstalled-desktop"
    elif os == "ubuntu-server":
        img_type = "live-server" if "live" in name else "server"
    elif os == "ubuntu-base":
        img_type = "base"
    elif os == "ubuntu-mini-iso":
        img_type = "mini-iso"
    elif os == "ubuntu-wsl":
        img_type = "wsl"
    elif "minimal" in name:
        img_type = "minimal"
    else:
        img_type = "desktop"

    if img_type not in type_map:
        sys.stderr.write("ERROR: Cannot handle type %s for %s\n" % (img_type, os))
        return None

    project = "ubuntu" if os in ("ubuntu-desktop", "ubuntu-server", "ubuntu-wsl") else os
    return project, img_type


def parse_milestone(milestone_str):
    m = milestone_name_re.search(milestone_str)
    if not m:
        sys.stderr.write(
            "ERROR: Milestone '%s' isn't a valid target for publishing.\n" % milestone_str)
        sys.exit(1)
    kind = m.group(1).capitalize()
    num = m.group(2)
    name = kind if not num else "%s %s" % (kind, num)
    code = name.lower().replace(' ', '-')
    return name, code


def do_publish_release(opts, project, img_type, buildstamp, arches, milestone_code, stable):
    primary_arches = arches & PRIMARY_ARCHES
    ports_arches = arches - PRIMARY_ARCHES

    if 'snapshot' in milestone_code:
        official = 'named'
    elif project == 'ubuntu' and img_type in OFFICIAL_TYPES and primary_arches:
        official = 'yes'
    else:
        official = 'named'

    if opts.prepublish:
        if official == 'named':
            return
        official = 'poolonly'

    # split primary from ports for official/poolonly
    if official in ('yes', 'poolonly') and primary_arches and ports_arches:
        do_publish_release(opts, project, img_type, buildstamp,
                           primary_arches, milestone_code, stable)
        do_publish_release(opts, project, img_type, buildstamp,
                           ports_arches, milestone_code, stable)
        return

    dir = type_map[img_type]
    if project == 'ubuntu' and img_type == 'wsl':
        dir = 'ubuntu-wsl/%s' % dir

    cmd = ['for-project', project, 'publish-release', dir, buildstamp, img_type, official]
    if milestone_code != 'final':
        cmd.append(milestone_code)

    prefix = ["ARCHES='%s'" % ' '.join(sorted(arches))]
    if stable is not None:
        prefix.insert(0, "DIST=%s" % stable)

    print(' '.join(prefix + cmd))


def main():
    parser = argparse.ArgumentParser(
        description='Generate publish-release commands from Test Observer')
    parser.add_argument('-s', '--series', required=True,
                        help="Release series codename (e.g. 'resolute')")
    parser.add_argument('-m', '--milestone', required=True,
                        help="Milestone name (e.g. 'Beta', 'Final')")
    parser.add_argument('-p', '--prepublish', action='store_true', default=False,
                        help='Pre-publish images to .pool')
    parser.add_argument('--stable',
                        help="Stable codename for point releases (e.g. 'jammy')")
    parser.add_argument('--api-url', default='https://tests-api.ubuntu.com',
                        help='Test Observer API base URL')
    opts = parser.parse_args()

    milestone_name, milestone_code = parse_milestone(opts.milestone)

    sys.stderr.write("Fetching approved artifacts for %s / %s...\n"
                     % (opts.series, milestone_name))

    artifacts = get_artifacts(opts.series, opts.api_url)

    build_map = defaultdict(lambda: defaultdict(lambda: defaultdict(set)))
    for artifact in artifacts:
        arch = get_arch(artifact, opts.api_url)
        if arch is None:
            sys.stderr.write("Warning: no builds for artifact %d (%s), skipping\n"
                             % (artifact["id"], artifact["name"]))
            continue
        result = derive_image_metadata(artifact)
        if result is None:
            continue
        project, img_type = result
        build_map[project][img_type][artifact["version"]].add(arch)

    print('\n## make backup:')
    print('cd ~/cdimage/; rm -rf www.prev; cp -al www www.prev; cd www')

    print('\n## publish images:')
    for project, builds in sorted(build_map.items()):
        for img_type, buildstamps in sorted(builds.items()):
            for buildstamp, arches in sorted(buildstamps.items()):
                do_publish_release(opts, project, img_type, buildstamp, arches,
                                   milestone_code, opts.stable)
        print()

    if not opts.prepublish:
        print('\n## fix name in headers:')
        print("find full -path '*/%s*HEADER.html' | xargs sed -i 's/Daily Build/%s/'"
              % (milestone_code, milestone_name))

    print('\n## check changes against www.prev:')
    print('diff -u <(cd ../www.prev/full && find | sort) <(cd full && find | sort) | less')


if __name__ == '__main__':
    main()
